# ---- 必填 ----
# PostgreSQL 超级用户密码（首次初始化生效）
POSTGRES_PASSWORD=change-me-to-a-strong-password
# 登录态签名密钥：openssl rand -hex 32
JWT_SECRET=change-me-to-a-64-char-random-string

# ---- 语义检索（可选；none = 纯关键词搜索）----
# provider 枚举：none | dashscope（OpenAI 兼容模式， base_url 填 .../compatible-mode/v1）
EMBEDDING_PROVIDER=none
# DashScope API Key（勿提交真实值到版本库）
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3
# 向量维度：须与库中 embeddings.embedding 列宽一致（迁移以 1024 为准）
EMBEDDING_DIM=1024
EMBEDDING_TOKEN_LIMIT=8192
# 请求时显式带 dimensions 参数 & 文本以 base64 传输（DashScope 兼容模式支持）
EMBEDDING_SEND_DIM=true
EMBEDDING_USE_BASE64=true
