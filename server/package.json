{
  "name": "@vibehub/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:mcp": "tsx src/mcp-entry.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "start:mcp": "node dist/mcp-entry.js",
    "prisma:migrate": "prisma migrate dev",
    "test": "vitest run",
    "test:e2e": "playwright test -c playwright.config.ts",
    "drill:restore": "bash scripts/restore-drill.sh"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/static": "^8.0.3",
    "@modelcontextprotocol/sdk": "^1.17.1",
    "@prisma/client": "^6.5.0",
    "@types/pg": "^8.23.1",
    "fastify": "^5.2.1",
    "pg": "^8.23.0",
    "pinyin-pro": "^3.29.4",
    "prisma": "^6.5.0",
    "sharp": "^0.33.5",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
